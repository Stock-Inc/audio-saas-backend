<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-add-nested-folders" author="codex">
        <addColumn tableName="audio_folders">
            <column name="parent_id" type="UUID"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="audio_folders"
                baseColumnNames="parent_id"
                referencedTableName="audio_folders"
                referencedColumnNames="id"
                constraintName="fk_audio_folders_parent"/>

        <createIndex
                tableName="audio_folders"
                indexName="idx_audio_folders_parent_id">
            <column name="parent_id"/>
        </createIndex>

        <dropUniqueConstraint
                tableName="audio_folders"
                constraintName="uk_audio_folders_owner_name"/>

        <sql>
            CREATE UNIQUE INDEX uk_audio_folders_root_name
            ON audio_folders (owner_id, LOWER(name))
            WHERE parent_id IS NULL
        </sql>
        <sql>
            CREATE UNIQUE INDEX uk_audio_folders_parent_name
            ON audio_folders (owner_id, parent_id, LOWER(name))
            WHERE parent_id IS NOT NULL
        </sql>
    </changeSet>
</databaseChangeLog>

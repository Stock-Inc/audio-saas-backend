<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-add-audio-processing-ids" author="bogda">

        <addColumn tableName="audio_uploads">
            <column name="request_id" type="UUID"/>
            <column name="record_id" type="UUID"/>
        </addColumn>

        <createIndex
                tableName="audio_uploads"
                indexName="idx_audio_uploads_request_id">
            <column name="request_id"/>
        </createIndex>

        <createIndex
                tableName="audio_uploads"
                indexName="idx_audio_uploads_record_id">
            <column name="record_id"/>
        </createIndex>

        <sql>
            UPDATE audio_uploads
            SET status = 'FAILED',
                error_message = 'Previously mocked; not forwarded'
            WHERE status = 'MOCKED'
        </sql>

    </changeSet>

</databaseChangeLog>

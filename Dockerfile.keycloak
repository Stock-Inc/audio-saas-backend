FROM quay.io/keycloak/keycloak:25.0.5

# Конфигурация Realm demo
COPY --chown=keycloak:keycloak \
    keycloak-import/demo-realm.json \
    /opt/keycloak/data/import/demo-realm.json

# Кастомная тема Sonora
COPY --chown=keycloak:keycloak \
    keycloak-themes/sonora \
    /opt/keycloak/themes/sonora
